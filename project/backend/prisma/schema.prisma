// Future Proof App - Database Schema
// Person 1: Backend Developer

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Parent/Guardian user
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   // Hashed password
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  children  Child[]  // One parent can have multiple children
}

// Child account
model Child {
  id        Int      @id @default(autoincrement())
  name      String
  age       Int
  balance   Float    @default(0.0)
  pin       String?  // Optional PIN for child login
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    Int      // Foreign key to parent
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions        Transaction[]
  budgets            Budget[]
  educationalProgress EducationalProgress[]
  goals              Goal[]
}

// Transaction record
model Transaction {
  id          Int      @id @default(autoincrement())
  amount      Float    // Negative for spending, positive for allowance
  description String
  category    String   @default("Other") // Food, Entertainment, Savings, etc.
  status      String   @default("pending") // pending, approved, rejected
  createdAt   DateTime @default(now())

  childId     Int
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
}

// Budget/Spending limit
model Budget {
  id          Int      @id @default(autoincrement())
  category    String   // e.g., "Weekly Spending", "Entertainment", "Savings Goal"
  limitAmount Float    // Maximum amount
  currentSpent Float   @default(0.0)
  period      String   @default("weekly") // weekly, monthly
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  childId     Int
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
}

// Educational progress tracking
model EducationalProgress {
  id          Int      @id @default(autoincrement())
  lessonId    Int      // Reference to lesson (stored in JSON/frontend)
  lessonTitle String
  completed   Boolean  @default(false)
  score       Int?     // Quiz score (0-100)
  completedAt DateTime?

  childId     Int
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
}

// Savings goals for children
model Goal {
  id            Int      @id @default(autoincrement())
  title         String   // e.g., "New Bike", "Video Game"
  description   String?  // Optional details
  targetAmount  Float    // Goal amount (e.g., 100.00)
  currentAmount Float    @default(0.0) // How much saved so far
  deadline      DateTime? // Optional deadline
  imageUrl      String?  // Optional image/emoji
  completed     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  completedAt   DateTime?

  childId       Int
  child         Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
}
