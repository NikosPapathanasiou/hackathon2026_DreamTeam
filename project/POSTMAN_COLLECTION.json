              }
            },
            "url": {
              "raw": "{{baseUrl}}/education/progress",
              "host": ["{{baseUrl}}"],
              "path": ["education", "progress"]
            }
          }
        },
        {
          "name": "Get Lesson Progress",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/education/progress/child/1/lesson/1",
              "host": ["{{baseUrl}}"],
              "path": ["education", "progress", "child", "1", "lesson", "1"]
            }
          }
        }
      ]
    }
  ]
}
