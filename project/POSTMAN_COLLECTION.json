                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/budgets",
              "host": ["{{baseUrl}}"],
              "path": ["budgets"]
            }
          }
        },
        {
          "name": "Update Budget",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"limitAmount\": 75.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/budgets/1",
              "host": ["{{baseUrl}}"],
              "path": ["budgets", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Education",
      "item": [
        {
          "name": "Get Progress By Child",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/education/progress/child/1",
              "host": ["{{baseUrl}}"],
              "path": ["education", "progress", "child", "1"]
            }
          }
        },
        {
          "name": "Record Progress",
          "request": {
            "method": "POST",
            "header": [
              {
